# ============================================
# КОНФИГУРАЦИЯ ДЛЯ МОДПАКА ИЗ CURSEFORGE
# ============================================
# Использование: скопируйте этот файл в .env
# cp env.modpack.example .env
#
# ВАЖНО: Перед использованием:
# 1. Поместите архив серверного пакета в папку ./modpacks/
# 2. Укажите правильное имя файла в CF_SERVER_MOD ниже

# Тип сервера - модпак из CurseForge
TYPE=CURSEFORGE

# Версия Minecraft (определится автоматически из модпака)
MINECRAFT_VERSION=

# Размер памяти для JVM (для модпаков рекомендуется 4G-8G)
MEMORY=6G

# Пароль для RCON (удаленное управление сервером)
RCON_PASSWORD=minecraft123

# Пароль для доступа к веб-панели администратора
ADMIN_PASSWORD=admin123

# Путь к архиву серверного пакета модпака
# Файл должен находиться в папке ./modpacks/
CF_SERVER_MOD=/data/modpacks/TerraFirmaGreg-Modern-0.11.15-curseforge.zip

# Папка для хранения данных этого сервера (внутри data/)
# Каждый сервер должен иметь свою папку: vanilla, terrafirmagreg, и т.д.
SERVER_DATA_DIR=terrafirmagreg

# Путь к сборке модпака (относительно корня проекта)
# При первом запуске содержимое этой папки будет скопировано в data/${SERVER_DATA_DIR}
# Если папка data/${SERVER_DATA_DIR} уже существует и содержит файлы, копирование не произойдет
MODPACK_PATH=modpacks/TerraFirmaGreg-Modern-0.11.15-serverpack

