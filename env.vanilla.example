# ============================================
# КОНФИГУРАЦИЯ ДЛЯ ВАНИЛЬНОГО СЕРВЕРА
# ============================================
# Использование: скопируйте этот файл в .env
# cp env.vanilla.example .env

# Тип сервера - ванильный
TYPE=VANILLA

# Версия Minecraft сервера
MINECRAFT_VERSION=latest

# Размер памяти для JVM (2G достаточно для ванильного сервера)
MEMORY=4G

# Пароль для RCON (удаленное управление сервером)
RCON_PASSWORD=minecraft123

# Пароль для доступа к веб-панели администратора
ADMIN_PASSWORD=admin123

# Путь к модпаку (не используется для ванильного сервера)
CF_SERVER_MOD=

# Папка для хранения данных этого сервера (внутри data/)
# Каждый сервер должен иметь свою папку: vanilla, terrafirmagreg, и т.д.
SERVER_DATA_DIR=vanilla

